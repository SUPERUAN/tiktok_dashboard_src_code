# Base URL of the NestJS backend server.
# Used to build internal redirect URLs and to extract the port for app.listen(...).
BACKEND_URL=http://localhost:3000

# Frontend application URL.
# Used for CORS configuration and redirecting the user back to the frontend, after TikTok login succeeds or fails.
FRONTEND_URL=http://localhost:4200

# TikTok OAuth redirect callback URL.
# This value must exactly match the Redirect URI configured in the TikTok Developer Console.
# It must also be the same value used for both authorization and token exchange.
# Example: https://mayson.com:3443/api/tiktok/callback
TIKTOK_REDIRECT_URI=https://your-domain.com:3443/api/tiktok/callback

# TikTok application client key from the TikTok Developer Portal.
TIKTOK_CLIENT_KEY=tiktok_client_key

# TikTok application client secret from the TikTok Developer Portal.
# Do not commit the real secret to source control.
TIKTOK_CLIENT_SECRET=tiktok_client_secret

# OAuth state value used to validate the callback request.
# Helps ensure the callback belongs to the login flow started by this app.
# Use a hard-to-guess value in real environments.
# Example: test123
TIKTOK_AUTH_STATE=yout_auth_state_value

# Path to the HTTPS private key file used by the callback server.
SSL_KEY_PATH=certs/your_cert_domain_key.pem

# Path to the HTTPS certificate file used by the callback server.
SSL_CERT_PATH=certs/your_cert_domain.pem